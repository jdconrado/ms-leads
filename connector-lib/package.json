{
  "name": "@nospi-connectors/leads",
  "version": "0.1.1",
  "description": "A library to provide Fetch Client, DTOs and other components about Leads Service.",
  "exports": {
    "./client": "./client/dist",
    "./dtos": "./dist"
  },
  "scripts": {
    "build": "tsc && cd client && npm run build && cd ..",
    "postbuild": "echo 'Build complete'",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "update-dtos": "ts-node ./copy-rename-paths.script.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jdconrado/ms-leads.git"
  },
  "publishConfig": {
