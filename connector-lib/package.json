  },
  "keywords": [
    "DTO",
    "front-end",
    "typescript"
  ],
  "author": "Juan Conrado",
  "license": "MIT",
  "files": [
    "dist",
    "client/dist"
  ],
  "dependencies": {
    "@automapper/classes": "^8.7.7",
    "@automapper/core": "^8.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "glob": "^10.3.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {}
}
