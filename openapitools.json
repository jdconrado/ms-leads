{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.11.0",
    "generators": {
      "default": {
        "generatorName": "typescript-fetch",
        "glob": "docs/openapi.json",
        "output": "./client-lib",
        "additionalProperties": {
          "supportsES6": true,
          "npmName": "@pivoxy/leads-client",
          "npmVersion": "1.0.0",
          "withInterfaces": true
        }
      }
    }
  }
}
