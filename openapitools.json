{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.11.0",
    "generators": {
      "default": {
        "generatorName": "typescript-axios",
        "glob": "docs/openapi.json",
        "output": "./client-lib",
        "additionalProperties": {
          "axiosVersion": "1.7.9",
          "supportsES6": true,
          "npmName": "@nospi/leads-client",
          "npmRepository": "https://verdaccio.nospi.co/",
          "npmVersion": "0.2.2",
          "withInterfaces": true
        }
      }
    }
  }
}
